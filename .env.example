# ---- Core ----
DATABASE_URL="postgresql://user:pass@host/nimantran?sslmode=require"
REDIS_URL="rediss://default:pass@host:6379"
AUTH_SECRET="generate-a-long-random-string"
NODE_ENV="development"

# ---- Branding (env-driven so rebrand/white-label needs no code change) ----
NEXT_PUBLIC_BRAND_DOMAIN="nimantran.app"

# ---- Auth / OTP ----
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
# (fallback) TWILIO_ACCOUNT_SID="" TWILIO_AUTH_TOKEN="" TWILIO_VERIFY_SID=""

# ---- Payments (Razorpay) ----
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Premium plan ids (created in Razorpay dashboard)
RAZORPAY_PLAN_PREMIUM_MONTHLY=""
RAZORPAY_PLAN_PREMIUM_YEARLY=""

# ---- WhatsApp Business Cloud API ----
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_BUSINESS_ID=""

# ---- Storage (Cloudflare R2, S3-compatible) ----
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="nimantran-media"
R2_PUBLIC_BASE_URL="https://cdn.nimantran.app"

# ---- Email (Resend) ----
RESEND_API_KEY=""

# ---- AI gateway ----
LLM_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
# (optional fallback) GOOGLE_DOCUMENT_AI_PROCESSOR_ID="" GOOGLE_APPLICATION_CREDENTIALS=""

# ---- Analytics / Ads ----
NEXT_PUBLIC_GA_ID="G-XXXXXXX"
NEXT_PUBLIC_ADSENSE_CLIENT=""     # only loaded on blog/marketing pages

# ---- Observability (Sentry) ----
# Server + edge runtime. Optional locally; recommended in staging/prod.
SENTRY_DSN=""
# Client-side error reporting (public — safe to expose in the browser).
NEXT_PUBLIC_SENTRY_DSN=""
# Required only when uploading source maps during `next build` (CI/prod).
SENTRY_ORG=""
SENTRY_PROJECT=""
# Optional: auth token for Sentry webpack plugin source-map upload
# SENTRY_AUTH_TOKEN=""

# ---- Jobs ----
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ---- Feature flags (ship features dark) ----
AI_INTAKE_ENABLED="true"
SUBSCRIPTIONS_ENABLED="true"
ADS_ENABLED="false"
